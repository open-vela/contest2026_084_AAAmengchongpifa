<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_084_AAAmengchongpifa" name="contest2026_084_AAAmengchongpifa">
    <!-- VelaPet, the smartwatch pet app.  Exposed to the openvela build tree
         as a demos package so the apps auto-discovery finds its Kconfig /
         CMakeLists without touching any production repo. -->
    <linkfile src="app/velapet" dest="packages/demos/contest2026_084_velapet"/>

    <!-- board/velapet_sf32lb52/ holds patches against the public
         vendor/sifli repo rather than a buildable board directory, so it is
         deliberately NOT linked into the build tree.  Application steps are
         in board/velapet_sf32lb52/README.md. -->
  </project>
</manifest>
