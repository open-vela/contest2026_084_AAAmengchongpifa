# Server
VELAPET_HOST=0.0.0.0
VELAPET_PORT=8000
VELAPET_PUBLIC_BASE_URL=
VELAPET_DATA_ROOT=./runtime-data

# Comma-separated device tokens. Empty means development mode without auth.
VELAPET_DEVICE_TOKENS=replace-with-a-long-random-token
VELAPET_CHAT_RATE_LIMIT_PER_MINUTE=20
VELAPET_MAX_UPLOAD_BYTES=5242880

# Xiaomi MiMo. The pay-as-you-go endpoint is shown below.
MIMO_API_KEY=
MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_CHAT_MODEL=mimo-v2.5-pro
MIMO_VISION_MODEL=mimo-v2.5
MIMO_TIMEOUT_SECONDS=30

# Optional reference-image understanding through Ark multimodal chat.
ARK_VISION_ENABLED=false
ARK_VISION_MODEL=doubao-seed-2-1-turbo-260628

# Image generation. "demo" makes a local device-compatible image so the
# complete upload/download flow can be demonstrated without a paid image API.
# "volcengine_ark" calls Seedream with a reference image as a data URI.
# "openai_compatible" is retained for other providers.
VELAPET_IMAGE_PROVIDER=demo
IMAGE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_API_KEY=
IMAGE_MODEL=doubao-seedream-5-0-pro-260628
IMAGE_API_MODE=generations
IMAGE_SIZE=2K
IMAGE_WATERMARK=false
IMAGE_RESPONSE_FORMAT=url
IMAGE_TIMEOUT_SECONDS=120
