diff --git a/boards/sf32lb52/sf32lb52_devkit_lcd/src/bsp_pinmux.c b/boards/sf32lb52/sf32lb52_devkit_lcd/src/bsp_pinmux.c
index fd51b9e..3d4a209 100644
--- a/boards/sf32lb52/sf32lb52_devkit_lcd/src/bsp_pinmux.c
+++ b/boards/sf32lb52/sf32lb52_devkit_lcd/src/bsp_pinmux.c
@@ -243,6 +243,17 @@ void BSP_PIN_LCD(void)
     HAL_PIN_Set(PAD_PA37, GPIO_A37, PIN_NOPULL, 1);
 #endif
 
+    /* Panel / LCM-adapter supply rails.  The DevKit-LCD is documented as
+     * having these always-on, but the LCM adapter only powers up the panel
+     * and touch controller once both gates are driven high (as done on
+     * LCHSPI-ULP).  Without this the module stays dark and the FT6146
+     * never answers on I2C.
+     */
+    HAL_PIN_Set(PAD_PA38, GPIO_A38, PIN_NOPULL, 1);
+    HAL_PIN_Set(PAD_PA26, GPIO_A26, PIN_NOPULL, 1);
+    BSP_GPIO_Set(38, 1, 1); // VSYS on
+    BSP_GPIO_Set(26, 1, 1); // VCC_3V3 on
+
 #ifdef BSP_USING_TOUCHD
     BSP_PIN_Touch();
 #endif
