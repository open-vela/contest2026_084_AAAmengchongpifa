diff --git a/boards/sf32lb52/sf32lb52_devkit_lcd/src/sifli_ap.c b/boards/sf32lb52/sf32lb52_devkit_lcd/src/sifli_ap.c
index 32be34b..c6bc87f 100644
--- a/boards/sf32lb52/sf32lb52_devkit_lcd/src/sifli_ap.c
+++ b/boards/sf32lb52/sf32lb52_devkit_lcd/src/sifli_ap.c
@@ -76,12 +76,23 @@ extern int sf32lb_adc_init(const char *devpath);
 extern int sf32lb_nor_automount(int minor, int block_offset, int block_count);
 #endif
 
-/* Follow SiFli SDK partition table (sf32lb52-lchspi-ulp):
- * FS_REGION offset=0x009A0000 size=0x00400000 on flash2.
+/* NOR filesystem partition on the MPI2 flash.
+ *
+ * NOTE: this board's README states the FS region is at 0x008A0000 (the
+ * sample boot log agrees: offset=2208 blocks), while the sibling
+ * LCHSPI-ULP board uses 0x009A0000.  This file originally inherited the
+ * LCHSPI-ULP value.  Both candidates are kept in one place so the offset
+ * can be flipped after checking the SiFli partition table on hardware.
  */
-#define SF32LB52_NOR_FS_OFFSET_BLOCKS (0x009A0000 / 4096)
+#define SF32LB52_NOR_FS_OFFSET_BLOCKS (0x008A0000 / 4096)
 #define SF32LB52_NOR_FS_SIZE_BLOCKS   (0x00400000 / 4096)
 
+/* The offset above was verified on hardware: the whole 4 MiB region reads
+ * back blank, and the first littlefs write landed exactly at 0x008A0000.
+ * The partition is formatted on demand from NSH ("velapet mkfs") rather than
+ * during boot, so a formatting problem cannot leave the board unbootable.
+ */
+
 #if defined(CONFIG_SPI) && defined(CONFIG_BSP_USING_SPI1)
 #  define SF32LB52_SPI1_PORT           0
 #endif
@@ -359,14 +370,9 @@ int sf32lb52_lchspi_ulp_bringup(void)
       serr("WARN: mkdir /data failed: %d\n", errno);
     }
 
-#ifdef CONFIG_FS_TMPFS
-  /* Keep /data writable for syscall and file API test cases. */
-  tmpret = nx_mount(NULL, "/data", "tmpfs", 0, NULL);
-  if (tmpret < 0 && tmpret != -EBUSY)
-    {
-      serr("WARN: mount tmpfs on /data failed: %d\n", tmpret);
-    }
-#endif
+  /* The /data filesystem is mounted after the NOR partition has been
+   * registered; see the CONFIG_MTD block further down.
+   */
 
 #if defined(CONFIG_RTC) && defined(CONFIG_RTC_DRIVER)
   struct rtc_lowerhalf_s *rtclower = NULL;
@@ -463,10 +469,13 @@ int sf32lb52_lchspi_ulp_bringup(void)
 #endif
 
 #ifdef CONFIG_I2C
-  /* Initialize I2C bus 0 on the touch panel pins. */
+  /* Initialize I2C bus 0 on the touch panel pins.
+   * DevKit-LCD wires touch I2C1 SCL to PA30.  PA37 is LCD_VADD_EN on this
+   * board, unlike LCHSPI-ULP where PA37 is the touch SCL.
+   */
   struct i2c_master_s *i2c0 = NULL;
 
-  HAL_PIN_Set(PAD_PA37, I2C1_SCL, PIN_PULLUP, 1);
+  HAL_PIN_Set(PAD_PA30, I2C1_SCL, PIN_PULLUP, 1);
   HAL_PIN_Set(PAD_PA33, I2C1_SDA, PIN_PULLUP, 1);
 
   i2c0 = sifli_i2cbus_initialize(0);
@@ -576,7 +585,71 @@ int sf32lb52_lchspi_ulp_bringup(void)
     {
       serr("WARN: sf32lb_nor_automount failed: %d\n", ret);
     }
-#endif
+  else
+    {
+      int data_mounted = 0;
+
+#ifdef CONFIG_FS_LITTLEFS
+      /* Never format here: a failure in this path would stop the board from
+       * booting with no way to see why.  Formatting is an explicit action
+       * ("velapet mkfs" from NSH) so errors surface on the console.
+       */
+
+      tmpret = nx_mount("/dev/config0", "/data", "littlefs", 0, NULL);
+      if (tmpret >= 0 || tmpret == -EBUSY)
+        {
+          syslog(LOG_INFO, "INFO: /data mounted from NOR (littlefs)\n");
+          data_mounted = 1;
+        }
+      else
+        {
+          serr("WARN: littlefs mount on /dev/config0 failed: %d\n", tmpret);
+        }
+#endif /* CONFIG_FS_LITTLEFS */
+
+#ifdef CONFIG_FS_TMPFS
+      if (!data_mounted)
+        {
+          /* Keep /data writable, but contents are lost on reboot. */
+          tmpret = nx_mount(NULL, "/data", "tmpfs", 0, NULL);
+          if (tmpret < 0 && tmpret != -EBUSY)
+            {
+              serr("WARN: mount tmpfs on /data failed: %d\n", tmpret);
+            }
+          else
+            {
+              syslog(LOG_WARNING,
+                     "WARN: /data is RAM-backed, VelaPet progress will not "
+                     "persist across reboot\n");
+            }
+        }
+#endif /* CONFIG_FS_TMPFS */
+
+      /* Directories used by the VelaPet app.  mkdir() does not create
+       * intermediate directories, so walk the path one level at a time.
+       */
+
+      if (mkdir("/data/agent", 0755) < 0 && errno != EEXIST)
+        {
+          serr("WARN: mkdir /data/agent failed: %d\n", errno);
+        }
+
+      if (mkdir("/data/agent/memory", 0755) < 0 && errno != EEXIST)
+        {
+          serr("WARN: mkdir /data/agent/memory failed: %d\n", errno);
+        }
+
+      if (mkdir("/data/agent/assets", 0755) < 0 && errno != EEXIST)
+        {
+          serr("WARN: mkdir /data/agent/assets failed: %d\n", errno);
+        }
+
+      if (mkdir("/data/agent/assets/pet", 0755) < 0 && errno != EEXIST)
+        {
+          serr("WARN: mkdir /data/agent/assets/pet failed: %d\n", errno);
+        }
+    }
+#endif /* CONFIG_MTD */
 
 #ifdef CONFIG_CDCACM
   ret = cdcacm_initialize(0, NULL);
-- 
2.34.1

